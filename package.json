{
  "name": "ai-shield",
  "version": "0.5.2",
  "private": true,
  "description": "LLM Security for TypeScript — Prompt Injection Detection, PII Protection, Cost Control, Audit Trail",
  "author": "StudioMeyer <hello@studiomeyer.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiomeyer-io/ai-shield.git"
  },
  "homepage": "https://github.com/studiomeyer-io/ai-shield",
  "bugs": {
    "url": "https://github.com/studiomeyer-io/ai-shield/issues"
  },
  "keywords": [
    "llm",
    "security",
    "prompt-injection",
    "pii",
    "ai",
    "openai",
    "anthropic",
    "gemini",
    "middleware",
    "typescript",
    "mcp"
  ],
  "workspaces": [
    "packages/core",
    "packages/openai",
    "packages/anthropic",
    "packages/gemini",
    "packages/middleware",
    "packages/classifier-onnx",
    "packages/ai-sdk",
    "packages/google-genai"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "pretest": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "tsc -b --clean && rm -rf packages/*/dist packages/*/*.tsbuildinfo",
    "bench:redos": "npm run build && node benchmarks/heuristic-redos.mjs",
    "bench:coverage": "npm run build && node benchmarks/coverage-limits.mjs",
    "test:openai-compat": "npm run build && node benchmarks/openai-compat.mjs",
    "test:package-exports": "npm run build && node benchmarks/package-entrypoints.mjs",
    "test:openai-peers": "npm run build && node benchmarks/openai-peers.mjs",
    "test:new-sdk-peers": "npm run build && node benchmarks/new-sdk-peers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
